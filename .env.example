# Hesab — Environment variables
# Copy to .env and adjust for your VPS

# SQLite database (persistent volume)
# For Docker: must be file:/app/data/app.db (mounted as ./data:/app/data)
# For local dev: file:./data/app.db
DATABASE_URL="file:./data/app.db"

# JWT secret for session cookies — generate a long random string!
# Example: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-secret-min-32-chars"

# Public URL of your app (for share links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Port
PORT=3000
